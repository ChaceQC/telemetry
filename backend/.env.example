# 后端本地开发示例。复制后按需另存为 .env，真实密钥和域名不要提交。

APP_ENV=local
APP_NAME=telemetry-backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=28117
BACKEND_RELOAD=false
LOG_LEVEL=info

# 本地浏览器联调默认前端端口：25173；预览端口：25174。
BACKEND_CORS_ALLOWED_ORIGINS=http://127.0.0.1:25173,http://localhost:25173,http://127.0.0.1:25174,http://localhost:25174
BACKEND_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
BACKEND_CORS_ALLOWED_HEADERS=Authorization,X-API-Key,Content-Type,Accept,Origin
BACKEND_CORS_ALLOW_CREDENTIALS=false

# 生产示例：BACKEND_TRUSTED_HOSTS=example.com
BACKEND_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]

# 后端被挂到 https://example.com/xxx/api/v1/... 时设置为 /xxx；普通 /api/v1 部署保持空。
BACKEND_ROOT_PATH=

# 经宿主机 Nginx HTTPS 反代时通常开启，并限制可信代理来源。
BACKEND_PROXY_HEADERS=false
BACKEND_FORWARDED_ALLOW_IPS=127.0.0.1

DATABASE_URL=sqlite:///./telemetry-dev.db

# ClickHouse 本地开发容器；示例密码仅用于本地占位，真实环境必须改为密钥管理注入。
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=28123
CLICKHOUSE_NATIVE_PORT=29001
CLICKHOUSE_DATABASE=telemetry
CLICKHOUSE_USER=telemetry_app
CLICKHOUSE_PASSWORD=change-me

# 生产必须使用 32 个 UTF-8 字节以上的随机密钥；不要提交真实值。
AUTH_SECRET_KEY=
AUTH_TOKEN_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
