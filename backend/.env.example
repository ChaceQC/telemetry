# 后端本地开发示例。复制后按需另存为 .env，真实密钥和域名不要提交。

APP_ENV=local
APP_NAME=telemetry-backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=28117
BACKEND_RELOAD=false
LOG_LEVEL=info

# 本地浏览器联调默认前端端口：25173；预览端口：25174。
BACKEND_CORS_ALLOWED_ORIGINS=http://127.0.0.1:25173,http://localhost:25173,http://127.0.0.1:25174,http://localhost:25174
BACKEND_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
BACKEND_CORS_ALLOWED_HEADERS=Authorization,X-API-Key,X-CSRF-Token,Content-Type,Accept,Origin
BACKEND_CORS_ALLOW_CREDENTIALS=false

# 生产示例：BACKEND_TRUSTED_HOSTS=example.com
BACKEND_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]

# 后端被挂到 https://example.com/xxx/api/v1/... 时设置为 /xxx；普通 /api/v1 部署保持空。
BACKEND_ROOT_PATH=

# 经宿主机 Nginx HTTPS 反代时通常开启，并限制可信代理来源。
BACKEND_PROXY_HEADERS=false
BACKEND_FORWARDED_ALLOW_IPS=127.0.0.1

DATABASE_URL=sqlite:///./telemetry-dev.db

# Trace 服务拓扑数据库侧最多扫描的 span 数；API limit 仅限制返回节点数。
QUERY_TRACE_TOPOLOGY_SPAN_SCAN_LIMIT=10000

# 摄入 API Key 固定窗口限流；默认关闭。验证前粗限流默认开启，拦截无效 key 高频探测。
INGEST_RATE_LIMIT_ENABLED=false
INGEST_RATE_LIMIT_PER_MINUTE=600
INGEST_RATE_LIMIT_BACKEND=memory
INGEST_RATE_LIMIT_KEY_PREFIX=telemetry
INGEST_API_KEY_PRECHECK_RATE_LIMIT_ENABLED=true
INGEST_API_KEY_PRECHECK_RATE_LIMIT_PER_MINUTE=1200
INGEST_API_KEY_PRECHECK_RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://127.0.0.1:26380/0

# ClickHouse 本地开发容器；示例密码仅用于本地占位，真实环境必须改为密钥管理注入。
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=28123
CLICKHOUSE_NATIVE_PORT=29001
CLICKHOUSE_DATABASE=telemetry
CLICKHOUSE_USER=telemetry_app
CLICKHOUSE_PASSWORD=change-me

# 生产必须使用 32 个 UTF-8 字节以上的随机密钥；不要提交真实值。
AUTH_SECRET_KEY=
AUTH_TOKEN_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_SESSION_COOKIE_NAME=telemetry_session
AUTH_CSRF_COOKIE_NAME=telemetry_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_COOKIE_PATH=/
# 本地可 false；生产必须 true。未设置时 local/test 自动 false，非本地自动 true。
# AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=5
AUTH_LOGIN_RATE_LIMIT_BACKEND=memory

# 生产硬化开关。
HEALTH_INCLUDE_RUNTIME_DETAILS=false
# 非本地默认关闭；如生产确需开放，显式设置为 true。
# OPENAPI_ENABLED=true
# DOCS_ENABLED=true
SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_CSP=
