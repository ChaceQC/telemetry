# 应用基础信息
APP_ENV=development
APP_VERSION=0.2.8

# 后端 API
API_HOST=127.0.0.1
API_PORT=28117
API_BASE_URL=http://127.0.0.1:28117

# 前端
FRONTEND_HOST=127.0.0.1
FRONTEND_DEV_PORT=25173
FRONTEND_PREVIEW_PORT=25174
VITE_API_BASE_URL=http://127.0.0.1:28117

# 浏览器和部署入口
CORS_ORIGINS=http://127.0.0.1:25173,http://127.0.0.1:25174
PUBLIC_BASE_URL=https://example.com:28443

# MySQL，本文件只提供可预期的本地开发占位凭据，不得用于生产
MYSQL_HOST=127.0.0.1
MYSQL_PORT=23316
MYSQL_CONTAINER_PORT=3306
MYSQL_DATABASE=telemetry
MYSQL_USER=telemetry_app
MYSQL_PASSWORD=telemetry_dev_mysql_password
MYSQL_ROOT_PASSWORD=telemetry_dev_mysql_root_password

# Trace 服务拓扑数据库侧最多扫描的 span 数；API limit 仅限制返回节点数
QUERY_TRACE_TOPOLOGY_SPAN_SCAN_LIMIT=10000

# ClickHouse，占位配置请在本地 .env 中补充真实凭据
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=28123
CLICKHOUSE_NATIVE_PORT=29001
CLICKHOUSE_CONTAINER_HTTP_PORT=8123
CLICKHOUSE_CONTAINER_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=telemetry
CLICKHOUSE_USER=telemetry_app
CLICKHOUSE_PASSWORD=

# MongoDB，本文件只提供可预期的本地开发占位凭据，不得用于生产
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27018
MONGODB_CONTAINER_PORT=27017
MONGODB_DATABASE=telemetry
MONGODB_USER=telemetry_app
MONGODB_PASSWORD=telemetry_dev_mongodb_password
MONGODB_ROOT_USER=telemetry_root
MONGODB_ROOT_PASSWORD=telemetry_dev_mongodb_root_password
# 若调整 MongoDB 用户、密码、端口或数据库名，请同步更新 URI。
MONGODB_URI=mongodb://telemetry_app:telemetry_dev_mongodb_password@127.0.0.1:27018/telemetry?authSource=telemetry

# Redis，占位配置请在本地 .env 中决定是否启用认证
REDIS_HOST=127.0.0.1
REDIS_PORT=26380
REDIS_CONTAINER_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:26380/0

# 摄入 API Key 限流；默认内存实现，生产/多实例可切换 redis
INGEST_RATE_LIMIT_ENABLED=false
INGEST_RATE_LIMIT_PER_MINUTE=600
INGEST_RATE_LIMIT_BACKEND=memory
INGEST_RATE_LIMIT_KEY_PREFIX=telemetry
